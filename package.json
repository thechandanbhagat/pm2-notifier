{
  "name": "@thechandanbhagat/pm2-notifier",
  "version": "0.2.0",
  "description": "Configurable PM2 CPU and lifecycle alerts for Teams, Slack, Discord and webhooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thechandanbhagat/pm2-notifier.git"
  },
  "homepage": "https://github.com/thechandanbhagat/pm2-notifier#readme",
  "bugs": {
    "url": "https://github.com/thechandanbhagat/pm2-notifier/issues"
  },
  "author": "Chandan Bhagat",
  "license": "MIT",
  "keywords": ["pm2", "pm2-module", "monitoring", "notifications", "teams", "slack", "discord", "webhook"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "apps": [{ "name": "@thechandanbhagat/pm2-notifier", "script": "dist/index.js", "exec_mode": "fork", "instances": 1, "watch": false, "kill_timeout": 12000, "restart_delay": 5000 }],
  "bin": {
    "pm2-notifier": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "assets",
    "CHANGELOG.md",
    "README.md"
  ],
  "bundleDependencies": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web-assets.cjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "npm run build && tsx test/integration.ts",
    "validate": "tsx src/cli.ts validate",
    "notify:test": "tsx src/cli.ts test",
    "ui": "tsx src/cli.ts ui",
    "prepack": "npm run build",
    "prepare": "tsx scripts/patch-bundled-dependencies.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "config": {
    "configPath": "",
    "envFile": "",
    "uiPort": 3100,
    "uiEnabled": true,
    "statePath": ""
  },
  "overrides": { "js-yaml": "^4.3.2", "basic-ftp": "^6.2.3" },
  "dependencies": {
    "pm2": "^7.0.4",
    "pmx": "^1.6.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
